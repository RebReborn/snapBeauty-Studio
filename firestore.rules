rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper check: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper check: Does the user own this record?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles containing account data and private saved presets
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Global community templates (lenses collection)
    match /lenses/{lensId} {
      // Anyone can browse lenses in the community marketplace
      allow read: if true;
      
      // Authenticated users can publish new lenses to the marketplace
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      
      // Users can only edit or delete lenses they published themselves
      allow update, delete: if isAuthenticated() && resource != null && resource.data.creatorId == request.auth.uid;
    }

    // Global community ideas and feature requests
    match /ideas/{ideaId} {
      // Anyone can browse ideas
      allow read: if true;
      
      // Authenticated users can submit ideas
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      
      // Authenticated users can upvote/interact with ideas
      allow update: if isAuthenticated();
      
      // Users can only delete ideas they created
      allow delete: if isAuthenticated() && resource != null && resource.data.creatorId == request.auth.uid;
    }
  }
}
